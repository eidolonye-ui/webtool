/**
 * @file ui/components/SovereignHeader.jsx
 * @description Professional Command Center Header for WebTool SaaS.
 * Implements Dynamic Persona Pill, Glassmorphism, and Environmental Awareness.
 * @version 3.0.0 - COMMAND CENTER UPGRADE
 */

import React, { useState, useEffect, useRef } from 'react';
import { C, SANS, T } from '../../core/config/theme_v3.js';
import { store } from '../../core/store/store.js';

const PERSONAS = [
  { id: 'developer', label: 'Developer', icon: '💼', color: '#0f4c75', focus: 'IRR & Margin' },
  { id: 'architect', label: 'Architect', icon: '📐', color: '#00b894', focus: 'Footprint & Form' },
  { id: 'builder', label: 'Builder', icon: '🏗️', color: '#e17055', focus: 'Site Works & Risk' },
];

// --- SUB-COMPONENTS ---

/**
 * Dynamic Persona Pill
 * Uses Refs to calculate exact position for the sliding background.
 */
const PersonaPill = ({ activePersona, onPersonaChange }) => {
  const containerRef = useRef(null);
  const pillRef = useRef(null);
  const [pillStyle, setPillStyle] = useState({ left: 0, width: 0 });

  useEffect(() => {
    if (containerRef.current && pillRef.current) {
      const containerRect = containerRef.current.getBoundingClientRect();
      const activeButton = containerRef.current.querySelector(`[data-persona="${activePersona}"]`);
      
      if (activeButton) {
        setPillStyle({
          left: activeButton.offsetLeft,
          width: activeButton.offsetWidth,
        });
      }
    }
    // Re-calculate on window resize
    const handleResize = () => {
        if (containerRef.current && pillRef.current) {
            const activeButton = containerRef.current.querySelector(`[data-persona="${activePersona}"]`);
            if (activeButton) {
                setPillStyle({
                    left: activeButton.offsetLeft,
                    width: activeButton.offsetWidth,
                });
            }
        }
    };
    window.addEventListener('resize', handleResize);
    return () => window.removeEventListener('resize', handleResize);
  }, [activePersona]);

  return (
    <div 
      ref={containerRef}
      style={{ 
        display: 'flex', 
        alignItems: 'center', 
        position: 'relative', 
        backgroundColor: 'rgba(0,0,0,0.25)', 
        padding: '4px', 
        borderRadius: '100px',
        border: '1px solid rgba(255,255,255,0.08)',
        boxShadow: 'inset 0 2px 4px rgba(0,0,0,0.2)'
      }}
    >
      {/* The Sliding Background */}
      <div 
        ref={pillRef}
        style={{ 
          position: 'absolute',
          height: 'calc(100% - 8px)',
          top: '4px',
          backgroundColor: '#fff',
          borderRadius: '100px',
          transition: 'all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275)',
          boxShadow: '0 4px 12px rgba(0,0,0,0.15)',
          zIndex: 0,
          left: pillStyle.left,
          width: pillStyle.width,
        }}
      />

      {PERSONAS.map((p) => {
        const isActive = activePersona === p.id;
        return (
          <button
            key={p.id}
            data-persona={p.id}
            onClick={() => onPersonaChange(p.id)}
            style={{
              position: 'relative',
              zIndex: 1,
              padding: '6px 18px',
              borderRadius: '100px',
              border: 'none',
              cursor: 'pointer',
              fontSize: T.fs.xs,
              fontWeight: 600,
              backgroundColor: 'transparent',
              color: isActive ? '#000' : 'rgba(255,255,255,0.6)',
              transition: 'color 0.3s ease',
              whiteSpace: 'nowrap'
            }}
          >
            {p.icon} {p.label}
          </button>
        );
      })}
    </div>
  );
};

// --- MAIN COMPONENT ---

export const SovereignHeader = ({ state: propState }) => {
  const [isScenarioOpen, setIsScenarioOpen] = useState(false);
  const [internalState, setInternalState] = useState(store.getState());
  const [hoveredScenario, setHoveredScenario] = useState(null);
  const [editingScenario, setEditingScenario] = useState(null);
  const [newScenarioName, setNewScenarioName] = useState('');
  
  const fileInputRef = useRef(null);
  const headerRef = useRef(null);

  useEffect(() => {
    const unsubscribe = store.subscribe((newState) => {
      setInternalState(newState);
    });
    if (propState) setInternalState(propState);

    const handleKeyDown = (e) => {
      if (e.altKey && ['1', '2', '3'].includes(e.key)) {
        const index = parseInt(e.key) - 1;
        const persona = PERSONAS[index];
        if (persona) {
          store.dispatch('system.activePersona', persona.id);
          store.dispatch('system.activeAccentColor', persona.color);
        }
      }
    };
    window.addEventListener('keydown', handleKeyDown);

    const handleClickOutside = (e) => {
      if (headerRef.current && !headerRef.current.contains(e.target)) {
        setIsScenarioOpen(false);
      }
    };
    document.addEventListener('mousedown', handleClickOutside);

    return () => {
      unsubscribe();
      window.removeEventListener('keydown', handleKeyDown);
      document.removeEventListener('mousedown', handleClickOutside);
    };
  }, [propState]);

  const state = internalState;
  const { system, scenarios } = state;
  const activeId = system.activeScenarioId;
  const activePersona = system.activePersona;
  const accentColor = system.activeAccentColor || '#0f4c75';
  const conflicts = system.consistencyConflicts || [];

  const getHealthStatus = () => {
    const count = conflicts.length;
    if (count === 0) return { label: 'SYSTEM HEALTHY', color: '#00b894', icon: '🟢' };
    if (count <= 3) return { label: 'MINOR DISCREPANCIES', color: '#fdcb6e', icon: '🟡' };
    return { label: 'CRITICAL CONFLICT', color: '#d63030', icon: '🔴' };
  };

  const health = getHealthStatus();
  const currentPersona = PERSONAS.find(p => p.id === activePersona) || PERSONAS[0];

  const handlePersonaChange = (id) => {
    const p = PERSONAS.find(p => p.id === id);
    store.dispatch('system.activePersona', id);
    store.dispatch('system.activeAccentColor', p.color);
  };

  const handleExport = () => {
    const data = JSON.stringify(state, null, 2);
    const blob = new Blob([data], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `Sovereign_Project_${new Date().toISOString().split('T')[0]}.json`;
    a.click();
    URL.revokeObjectURL(url);
  };

  const handleImport = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (event) => {
      const jsonString = event.target.result;
      const result = store.restoreFromArchive(jsonString);
      if (result.success) {
        alert('Project archive restored successfully.');
      } else {
        alert(`Restore failed: ${result.error}`);
      }
    };
    reader.readAsText(file);
  };

  const commitRename = (id) => {
    if (editingScenario && editingScenario.value.trim()) {
      store.renameScenario(id, editingScenario.value);
    }
    setEditingScenario(null);
  };

  const commitCreate = () => {
    if (newScenarioName.trim()) {
      store.createScenario(newScenarioName);
      setNewScenarioName('');
      setIsScenarioOpen(false);
    }
  };

  return (
    <header 
      ref={headerRef} 
      style={{ 
        position: 'sticky',
        top: 0,
        zIndex: 1000,
        display: 'flex', 
        justifyContent: 'space-between', 
        alignItems: 'center',
        padding: `${T.sp.md} ${T.sp.lg}`, 
        fontFamily: SANS,
        // Glassmorphic Base
        backgroundColor: `rgba(255, 255, 255, 0.05)`,
        backdropFilter: 'blur(25px)',
        WebkitBackdropFilter: 'blur(25px)',
        borderBottom: `1px solid rgba(255, 255, 255, 0.1)`,
        // Environmental Color Sync
        boxShadow: `0 4px 30px ${accentColor}22`,
        transition: 'all 0.8s cubic-bezier(0.23, 1, 0.32, 1)'
      }}
    >
      {/* LEFT: Brand & Global Health */}
      <div style={{ display: 'flex', alignItems: 'center', gap: T.sp.lg }}>
        <div style={{ 
          width: 36, 
          height: 36, 
          borderRadius: 8, 
          background: `linear-gradient(135deg, ${accentColor}, #fff)`,
          display: 'flex', 
          alignItems: 'center', 
          justifyContent: 'center', 
          fontWeight: 800, 
          fontSize: T.fs.sm,
          boxShadow: `0 4px 12px ${accentColor}44`,
          color: '#fff'
        }}>
          WT
        </div>
        
        <div style={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
          <h1 style={{ fontSize: T.fs.md, fontWeight: 700, margin: 0, color: '#fff', letterSpacing: '-0.5px' }}>
            WebTool <span style={{ opacity: 0.4, fontWeight: 400, fontSize: T.fs.xs }}>Sovereign Platform</span>
          </h1>
          <div style={{ 
            display: 'flex', 
            alignItems: 'center', 
            gap: 6, 
            fontSize: '10px', 
            fontWeight: 700, 
            color: health.color,
            letterSpacing: '1px',
            textTransform: 'uppercase'
          }}>
            <span>{health.icon} {health.label}</span>
            {conflicts.length > 0 && (
              <span style={{ opacity: 0.5, fontWeight: 400 }}>({conflicts.length} issues)</span>
            )}
          </div>
        </div>
      </div>

      {/* CENTER: Persona Command Context */}
      <div style={{ display: 'flex', alignItems: 'center', gap: T.sp.lg }}>
        <PersonaPill activePersona={activePersona} onPersonaChange={handlePersonaChange} />
        
        <div style={{ 
          width: 1, 
          height: 24, 
          backgroundColor: 'rgba(255,255,255,0.1)' 
        }} />

        <div style={{ 
          fontSize: T.fs.xs, 
          fontWeight: 500, 
          color: 'rgba(255,255,255,0.6)',
          fontStyle: 'italic' 
        }}>
          Focus: <span style={{ color: '#fff', fontWeight: 700 }}>{currentPersona?.focus}</span>
        </div>
      </div>

      {/* RIGHT: Scenario & Project Management */}
      <div style={{ display: 'flex', gap: T.sp.md, alignItems: 'center' }}>
        <div style={{ position: 'relative' }}>
          <button 
            onClick={() => setIsScenarioOpen(!isScenarioOpen)}
            style={{ 
              backgroundColor: 'rgba(255,255,255,0.05)', 
              color: '#fff', 
              border: '1px solid rgba(255,255,255,0.1)', 
              padding: '6px 14px', 
              borderRadius: 8, 
              fontSize: T.fs.xs,
              cursor: 'pointer',
              display: 'flex',
              alignItems: 'center',
              gap: 10,
              transition: 'all 0.2s ease'
            }}
          >
            <span style={{ opacity: 0.5, fontWeight: 600 }}>SCENARIO</span>
            <span style={{ fontWeight: 700 }}>{activeId ? activeId.toUpperCase().replace(/_/g, ' ') : 'DEFAULT'}</span>
            <span style={{ fontSize: '8px', opacity: 0.5 }}>▼</span>
          </button>

          {isScenarioOpen && (
            <div style={{ 
              position: 'absolute', 
              top: 'calc(100% + 12px)', 
              right: 0, 
              backgroundColor: 'rgba(15, 28, 41, 0.95)', 
              backdropFilter: 'blur(20px)',
              color: '#fff', 
              borderRadius: 12, 
              boxShadow: '0 20px 50px rgba(0,0,0,0.5)', 
              width: 300, 
              zIndex: 1001,
              border: '1px solid rgba(255,255,255,0.1)',
              overflow: 'hidden',
              animation: 'fadeIn 0.2s ease'
            }}>
              <div style={{ padding: '14px', borderBottom: '1px solid rgba(255,255,255,0.1)', backgroundColor: 'rgba(255,255,255,0.05)' }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: 10 }}>
                  <span style={{ fontSize: '10px', fontWeight: 800, color: 'rgba(255,255,255,0.4)', letterSpacing: '1px' }}>SCENARIO ARCHIVE</span>
                </div>
                <div style={{ display: 'flex', gap: 8 }}>
                  <input 
                    value={newScenarioName}
                    onChange={(e) => setNewScenarioName(e.target.value)}
                    onKeyDown={(e) => e.key === 'Enter' && commitCreate()}
                    placeholder="New scenario..."
                    style={{ 
                      flex: 1,
                      backgroundColor: 'rgba(0,0,0,0.3)',
                      border: '1px solid rgba(255,255,255,0.1)',
                      borderRadius: 6,
                      color: '#fff',
                      fontSize: '11px',
                      padding: '6px 10px',
                      outline: 'none'
                    }}
                  />
                  <button 
                    onClick={commitCreate}
                    style={{ 
                      border: 'none', 
                      backgroundColor: '#fff', 
                      color: '#000', 
                      borderRadius: 6, 
                      width: 30, 
                      height: 30, 
                      cursor: 'pointer', 
                      fontWeight: 'bold' 
                    }}
                  >
                    +
                  </button>
                </div>
              </div>
              <div style={{ maxHeight: 320, overflowY: 'auto' }}>
                {Object.keys(scenarios).map(id => (
                  <div 
                    key={id}
                    onMouseEnter={() => setHoveredScenario(id)}
                    onMouseLeave={() => setHoveredScenario(null)}
                    style={{ 
                      padding: '12px 16px', 
                      cursor: 'pointer', 
                      fontSize: T.fs.xs, 
                      fontWeight: 500,
                      backgroundColor: activeId === id ? 'rgba(255,255,255,0.1)' : 'transparent',
                      color: activeId === id ? '#fff' : 'rgba(255,255,255,0.6)',
                      display: 'flex',
                      justifyContent: 'space-between',
                      alignItems: 'center',
                      borderBottom: '1px solid rgba(255,255,255,0.03)',
                    }}
                    onClick={() => {
                      if (!editingScenario) {
                        store.setActiveScenario(id);
                        setIsScenarioOpen(false);
                      }
                    }}
                  >
                    <span style={{ flex: 1 }}>{id.toUpperCase().replace(/_/g, ' ')}</span>
                    
                    {hoveredScenario === id && (
                      <div style={{ display: 'flex', gap: 8, opacity: 1 }}>
                         <button 
                          onClick={(e) => { e.stopPropagation(); setEditingScenario({ id, value: id }); }}
                          style={{ border: 'none', background: 'none', color: 'rgba(255,255,255,0.4)', cursor: 'pointer', fontSize: '10px' }}
                        >✎</button>
                        {id !== 'default' && (
                          <button 
                            onClick={(e) => { 
                              e.stopPropagation(); 
                              if(confirm('Delete scenario?')) store.deleteScenario(id); 
                            }}
                            style={{ border: 'none', background: 'none', color: '#ff4d4f', cursor: 'pointer', fontSize: '10px' }}
                          >✖</button>
                        )}
                      </div>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        <div style={{ display: 'flex', gap: 8 }}>
          <input 
            type="file" 
            ref={fileInputRef} 
            style={{ display: 'none' }} 
            accept=".json" 
            onChange={handleImport} 
          />
          <button 
            onClick={() => fileInputRef.current.click()}
            style={{ 
              backgroundColor: 'rgba(255,255,255,0.05)', 
              border: '1px solid rgba(255,255,255,0.1)', 
              color: '#fff', 
              padding: '6px 14px', 
              borderRadius: 8, 
              cursor: 'pointer', 
              fontSize: T.fs.xs,
              fontFamily: SANS,
              display: 'flex',
              alignItems: 'center',
              gap: 8
            }}
          >
            <span>📥</span> Import
          </button>
          <button 
            onClick={handleExport}
            style={{ 
              backgroundColor: 'rgba(255,255,255,0.05)', 
              border: '1px solid rgba(255,255,255,0.1)', 
              color: '#fff', 
              padding: '6px 14px', 
              borderRadius: 8, 
              cursor: 'pointer', 
              fontSize: T.fs.xs,
              fontFamily: SANS,
              display: 'flex',
              alignItems: 'center',
              gap: 8
            }}
          >
            <span>📦</span> Export
          </button>
        </div>
      </div>

      <style>{`
        @keyframes fadeIn {
          from { opacity: 0; transform: translateY(-10px); }
          to { opacity: 1; transform: translateY(0); }
        }
      `}</style>
    </header>
  );
};
