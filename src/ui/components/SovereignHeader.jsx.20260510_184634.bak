/**
 * @file ui/components/SovereignHeader.jsx
 * @description Professional Command Center Header for WebTool SaaS.
 * Implements Sliding Persona Logic, Inline Scenario Editing, and Global Theme Sync.
 * @version 2.0.0 - ULTRA-LUXURY SOVEREIGN POLISH
 */

import React, { useState, useEffect, useRef } from 'react';
import { C, SANS, T } from '../../core/config/theme_v3.js';
import { store } from '../../core/store/store.js';

const PERSONAS = [
  { id: 'developer', label: 'Developer', icon: '💼', color: '#0f4c75', focus: 'IRR & Margin' },
  { id: 'architect', label: 'Architect', icon: '📐', color: '#00b894', focus: 'Footprint & Form' },
  { id: 'builder', label: 'Builder', icon: '🏗️', color: '#e17055', focus: 'Site Works & Risk' },
];

export const SovereignHeader = ({ state: propState }) => {
  const [isScenarioOpen, setIsScenarioOpen] = useState(false);
  const [internalState, setInternalState] = useState(store.getState());
  const [hoveredScenario, setHoveredScenario] = useState(null);
  const [editingScenario, setEditingScenario] = useState(null); // { id, value }
  const [newScenarioName, setNewScenarioName] = useState('');
  
  const fileInputRef = useRef(null);
  const headerRef = useRef(null);

  useEffect(() => {
    const unsubscribe = store.subscribe((newState) => {
      setInternalState(newState);
    });
    if (propState) setInternalState(propState);

    // Global Keyboard Shortcuts (Alt+1, 2, 3)
    const handleKeyDown = (e) => {
      if (e.altKey && ['1', '2', '3'].includes(e.key)) {
        const index = parseInt(e.key) - 1;
        const persona = PERSONAS[index];
        if (persona) {
          store.dispatch('system.activePersona', persona.id);
          store.dispatch('system.activeAccentColor', persona.color);
        }
      }
    };
    window.addEventListener('keydown', handleKeyDown);

    // Click Outside to close Scenario Archive
    const handleClickOutside = (e) => {
      if (headerRef.current && !headerRef.current.contains(e.target)) {
        setIsScenarioOpen(false);
      }
    };
    document.addEventListener('mousedown', handleClickOutside);

    return () => {
      unsubscribe();
      window.removeEventListener('keydown', handleKeyDown);
      document.removeEventListener('mousedown', handleClickOutside);
    };
  }, [propState]);

  const state = internalState;
  const { system, scenarios } = state;
  const activeId = system.activeScenarioId;
  const activePersona = system.activePersona;
  const accentColor = system.activeAccentColor || '#0f4c75';
  const conflicts = system.consistencyConflicts || [];

  const getHealthStatus = () => {
    const count = conflicts.length;
    if (count === 0) return { label: 'SYSTEM HEALTHY', color: '#00b894', icon: '🟢' };
    if (count <= 3) return { label: 'MINOR DISCREPANCIES', color: '#fdcb6e', icon: '🟡' };
    return { label: 'CRITICAL CONFLICT', color: '#d63030', icon: '🔴' };
  };

  const health = getHealthStatus();
  const currentPersona = PERSONAS.find(p => p.id === activePersona) || PERSONAS[0];
  const themeColor = currentPersona.color;

  const handlePersonaChange = (id) => {
    const p = PERSONAS.find(p => p.id === id);
    store.dispatch('system.activePersona', id);
    store.dispatch('system.activeAccentColor', p.color);
  };

  const handleExport = () => {
    const data = JSON.stringify(state, null, 2);
    const blob = new Blob([data], { type: 'application/json' });
    const url = URL.createObjectURL(blob);
    const a = document.createElement('a');
    a.href = url;
    a.download = `Sovereign_Project_${new Date().toISOString().split('T')[0]}.json`;
    a.click();
    URL.revokeObjectURL(url);
  };

  const handleImport = (e) => {
    const file = e.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = (event) => {
      const jsonString = event.target.result;
      const result = store.restoreFromArchive(jsonString);
      if (result.success) {
        alert('Project archive restored successfully.');
      } else {
        alert(`Restore failed: ${result.error}`);
      }
    };
    reader.readAsText(file);
  };

  const commitRename = (id) => {
    if (editingScenario && editingScenario.value.trim()) {
      store.renameScenario(id, editingScenario.value);
    }
    setEditingScenario(null);
  };

  const commitCreate = () => {
    if (newScenarioName.trim()) {
      store.createScenario(newScenarioName);
      setNewScenarioName('');
      setIsScenarioOpen(false);
    }
  };

  return (
    <header ref={headerRef} style={{ 
      position: 'relative',
      background: `linear-gradient(135deg, ${themeColor}cc, ${themeColor}99)`, 
      backdropFilter: 'blur(20px)',
      WebkitBackdropFilter: 'blur(20px)',
      color: '#fff', 
      padding: `${T.sp.md} ${T.sp.lg}`, 
      display: 'flex', 
      justifyContent: 'space-between', 
      alignItems: 'center',
      borderBottom: `1px solid ${accentColor}44`,
      boxShadow: `0 4px 30px ${themeColor}33`,
      zIndex: 1000,
      fontFamily: SANS,
      transition: 'all 0.6s cubic-bezier(0.23, 1, 0.32, 1)'
    }}>
      <style>{`
        @keyframes pulse-glow {
          0% { opacity: 0.6; }
          50% { opacity: 1; }
          100% { opacity: 0.6; }
        }
        @keyframes fadeIn {
          from { opacity: 0; transform: translateY(-10px); }
          to { opacity: 1; transform: translateY(0); }
        }
      `}</style>

      {/* LEFT: Brand & Global Health */}
      <div style={{ display: 'flex', alignItems: 'center', gap: T.sp.lg }}>
        <div style={{ 
          backgroundColor: '#fff', 
          color: themeColor, 
          width: 32, 
          height: 32, 
          borderRadius: 6, 
          display: 'flex', 
          alignItems: 'center', 
          justifyContent: 'center', 
          fontWeight: 800, 
          fontSize: T.fs.sm,
          boxShadow: '0 0 15px rgba(255,255,255,0.4)'
        }}>
          WT
        </div>
        
        <div style={{ display: 'flex', flexDirection: 'column', gap: 2 }}>
          <h1 style={{ fontSize: T.fs.md, fontWeight: 700, margin: 0, letterSpacing: '-0.5px' }}>
            WebTool <span style={{ opacity: 0.6, fontWeight: 400, fontSize: T.fs.xs }}>v2.3 Sovereign Platform</span>
          </h1>
          <div style={{ 
            display: 'flex', 
            alignItems: 'center', 
            gap: 6, 
            fontSize: '10px', 
            fontWeight: 800, 
            color: health.color,
            letterSpacing: '0.5px',
            animation: 'pulse-glow 2s infinite ease-in-out'
          }}>
            <span>{health.icon} {health.label}</span>
            {conflicts.length > 0 && (
              <span style={{ opacity: 0.7, fontWeight: 400 }}>({conflicts.length} issues)</span>
            )}
          </div>
        </div>
      </div>

      {/* CENTER: Persona Command Context - Sliding Pill Implementation */}
      <div style={{ 
        display: 'flex', 
        alignItems: 'center', 
        gap: T.sp.md,
        padding: '4px',
        backgroundColor: 'rgba(0,0,0,0.4)',
        borderRadius: '100px',
        border: '1px solid rgba(255,255,255,0.1)',
        position: 'relative',
        boxShadow: 'inset 0 2px 4px rgba(0,0,0,0.3)'
      }}>
        <div style={{ display: 'flex', position: 'relative', zIndex: 1 }}>
          {PERSONAS.map((p, idx) => {
            const isActive = activePersona === p.id;
            return (
              <button 
                key={p.id}
                onClick={() => handlePersonaChange(p.id)}
                style={{ 
                  position: 'relative',
                  padding: '6px 16px', 
                  borderRadius: '100px', 
                  border: 'none', 
                  cursor: 'pointer', 
                  fontSize: T.fs.xs,
                  fontWeight: 600,
                  transition: 'color 0.3s ease',
                  backgroundColor: 'transparent',
                  color: isActive ? '#000' : 'rgba(255,255,255,0.6)',
                  zIndex: 2,
                }}
              >
                {p.icon} {p.label}
              </button>
            );
          })}
          
          {/* Sliding Pill Background */}
          <div style={{ 
            position: 'absolute',
            top: '4px',
            left: `${PERSONAS.findIndex(p => p.id === activePersona) * 92}px`, // Approx width
            width: '92px',
            height: 'calc(100% - 8px)',
            backgroundColor: '#fff',
            borderRadius: '100px',
            transition: 'all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275)',
            boxShadow: `0 0 15px ${themeColor}aa`,
            zIndex: 1
          }} />
        </div>
        <div style={{ 
          width: 1, 
          height: 14, 
          backgroundColor: 'rgba(255,255,255,0.2)', 
          margin: '0 8px' 
        }} />
        <div style={{ fontSize: T.fs.xs, fontWeight: 500, color: 'rgba(255,255,255,0.8)', fontStyle: 'italic' }}>
          Focus: <span style={{ color: '#fff', fontWeight: 700 }}>{currentPersona?.focus}</span>
        </div>
      </div>

      {/* RIGHT: Scenario & Project Management */}
      <div style={{ display: 'flex', gap: T.sp.md, alignItems: 'center' }}>
        <div style={{ position: 'relative' }}>
          <button 
            onClick={() => setIsScenarioOpen(!isScenarioOpen)}
            style={{ 
              backgroundColor: 'rgba(255,255,255,0.1)', 
              color: '#fff', 
              border: '1px solid rgba(255,255,255,0.2)', 
              padding: '6px 12px', 
              borderRadius: 6, 
              fontSize: T.fs.xs,
              cursor: 'pointer',
              display: 'flex',
              alignItems: 'center',
              gap: 8,
              transition: 'all 0.2s ease'
            }}
          >
            <span style={{ opacity: 0.6, fontWeight: 600 }}>SCENARIO:</span>
            <span style={{ fontWeight: 700 }}>{activeId ? activeId.toUpperCase().replace(/_/g, ' ') : 'DEFAULT'}</span>
            <span style={{ fontSize: '8px', opacity: 0.5 }}>▼</span>
          </button>

          {isScenarioOpen && (
            <div style={{ 
              position: 'absolute', 
              top: '110%', 
              right: 0, 
              backgroundColor: 'rgba(15, 76, 117, 0.98)', 
              color: '#fff', 
              borderRadius: 12, 
              backdropFilter: 'blur(30px)',
              WebkitBackdropFilter: 'blur(30px)',
              boxShadow: '0 20px 50px rgba(0,0,0,0.4)', 
              width: 280, 
              zIndex: 1001,
              overflow: 'hidden',
              border: '1px solid rgba(255,255,255,0.1)',
              animation: 'fadeIn 0.2s ease'
            }}>
              <div style={{ padding: '12px', borderBottom: '1px solid rgba(255,255,255,0.1)', display: 'flex', flexDirection: 'column', gap: 8, backgroundColor: 'rgba(0,0,0,0.2)' }}>
                <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                  <span style={{ fontSize: '10px', fontWeight: 800, color: 'rgba(255,255,255,0.5)' }}>SCENARIO ARCHIVE</span>
                </div>
                <div style={{ display: 'flex', gap: 8 }}>
                  <input 
                    value={newScenarioName}
                    onChange={(e) => setNewScenarioName(e.target.value)}
                    onKeyDown={(e) => e.key === 'Enter' && commitCreate()}
                    placeholder="New scenario name..."
                    style={{ 
                      flex: 1,
                      backgroundColor: 'rgba(0,0,0,0.3)',
                      border: '1px solid rgba(255,255,255,0.1)',
                      borderRadius: 4,
                      color: '#fff',
                      fontSize: '11px',
                      padding: '4px 8px',
                      outline: 'none'
                    }}
                  />
                  <button 
                    onClick={commitCreate}
                    style={{ 
                      border: 'none', 
                      backgroundColor: '#fff', 
                      color: themeColor, 
                      borderRadius: 4, 
                      width: 28, 
                      height: 24, 
                      cursor: 'pointer', 
                      fontSize: '14px', 
                      fontWeight: 'bold' 
                    }}
                  >
                    +
                  </button>
                </div>
              </div>
              <div style={{ maxHeight: 300, overflowY: 'auto' }}>
                {Object.keys(scenarios).map(id => (
                  <div 
                    key={id}
                    onMouseEnter={() => setHoveredScenario(id)}
                    onMouseLeave={() => setHoveredScenario(null)}
                    style={{ 
                      position: 'relative',
                      padding: '12px', 
                      cursor: 'pointer', 
                      fontSize: T.fs.xs, 
                      fontWeight: 500,
                      backgroundColor: activeId === id ? 'rgba(255,255,255,0.1)' : 'transparent',
                      color: activeId === id ? '#fff' : 'rgba(255,255,255,0.7)',
                      display: 'flex',
                      justifyContent: 'space-between',
                      alignItems: 'center',
                      transition: 'all 0.1s ease',
                      borderLeft: activeId === id ? `3px solid #fff` : '3px solid transparent',
                      userSelect: 'none',
                      borderBottom: '1px solid rgba(255,255,255,0.05)'
                    }}
                    onClick={() => {
                      if (!editingScenario) {
                        store.setActiveScenario(id);
                        setIsScenarioOpen(false);
                      }
                    }}
                  >
                    {editingScenario?.id === id ? (
                      <input 
                        autoFocus
                        value={editingScenario.value}
                        onChange={(e) => setEditingScenario({ ...editingScenario, value: e.target.value })}
                        onBlur={() => commitRename(id)}
                        onKeyDown={(e) => e.key === 'Enter' && commitRename(id)}
                        style={{ 
                          backgroundColor: 'rgba(0,0,0,0.3)',
                          border: '1px solid #fff',
                          borderRadius: 3,
                          color: '#fff',
                          fontSize: T.fs.xs,
                          padding: '2px 6px',
                          outline: 'none',
                          width: '100%'
                        }}
                      />
                    ) : (
                      <span style={{ flex: 1 }}>{id.toUpperCase().replace(/_/g, ' ')}</span>
                    )}
                    
                    <div style={{ 
                      display: 'flex', 
                      gap: 6, 
                      opacity: hoveredScenario === id ? 1 : 0, 
                      transition: 'opacity 0.2s ease',
                      pointerEvents: hoveredScenario === id ? 'auto' : 'none'
                    }}>
                      <button 
                        onClick={(e) => {
                          e.stopPropagation();
                          setEditingScenario({ id, value: id });
                        }}
                        style={{ 
                          border: 'none', 
                          backgroundColor: 'transparent', 
                          color: 'rgba(255,255,255,0.5)', 
                          cursor: 'pointer', 
                          fontSize: '10px', 
                          padding: '2px 4px',
                          borderRadius: 3
                        }}
                        title="Rename"
                      >
                        ✎
                      </button>
                      {id !== 'default' && (
                        <button 
                          onClick={(e) => {
                            e.stopPropagation();
                            if (confirm(`Delete scenario ${id}?`)) {
                              store.deleteScenario(id);
                            }
                          }}
                          style={{ 
                          border: 'none', 
                          backgroundColor: 'transparent', 
                          color: '#ff4d4f', 
                          cursor: 'pointer', 
                          fontSize: '10px', 
                          padding: '2px 4px',
                          borderRadius: 3
                        }}
                        title="Delete"
                      >
                        ✖
                      </button>
                      )}
                    </div>
                    
                    {hoveredScenario !== id && activeId === id && (
                      <span style={{ fontSize: '10px', color: '#fff', fontWeight: 800, marginLeft: 8 }}>Active</span>
                    )}
                  </div>
                ))}
              </div>
            </div>
          )}
        </div>

        <div style={{ display: 'flex', gap: 8 }}>
          <input 
            type="file" 
            ref={fileInputRef} 
            style={{ display: 'none' }} 
            accept=".json" 
            onChange={handleImport} 
          />
          <button 
            onClick={() => fileInputRef.current.click()}
            style={{ 
              backgroundColor: 'rgba(255,255,255,0.1)', 
              border: '1px solid rgba(255,255,255,0.2)', 
              color: '#fff', 
              padding: '6px 12px', 
              borderRadius: 6, 
              cursor: 'pointer', 
              fontSize: T.fs.xs,
              fontFamily: SANS,
              fontWeight: 600,
              transition: 'all 0.2s ease',
              display: 'flex',
              alignItems: 'center',
              gap: 6
            }}
          >
            <span>📥</span> Import
          </button>
          <button 
            onClick={handleExport}
            style={{ 
              backgroundColor: 'rgba(255,255,255,0.1)', 
              border: '1px solid rgba(255,255,255,0.2)', 
              color: '#fff', 
              padding: '6px 12px', 
              borderRadius: 6, 
              cursor: 'pointer', 
              fontSize: T.fs.xs,
              fontFamily: SANS,
              fontWeight: 600,
              transition: 'all 0.2s ease',
              display: 'flex',
              alignItems: 'center',
              gap: 6
            }}
          >
            <span>📦</span> Export
          </button>
        </div>
      </div>
    </header>
  );
};
