/**
 * @file ui/panels/SiteInvestigationPanel.jsx
 * @description Professional Site Investigation Panel with Step-by-Step Sovereign Workflow.
 * Restored to "Warm Luxury" visual standards and professional terminology.
 * @version 3.2.2 - DOCUMENT TERMS & RESET FIXED
 */

import React, { useState, useEffect, useRef } from 'react';
import { UIPanel, UIInput, UIButton, YieldWaterfall } from '../components/Common_V2.jsx';
import { C, SANS, T } from '../../core/config/theme_v3.js';
import { store } from '../../core/store/store.js';
import { extractFileText } from '../../domain/extraction/pdf_ocr.js';
import { extractAllFields } from '../../domain/extraction/unified_engine.js';
import { parseDocumentWithAI } from '../../domain/extraction/ai_adapter.js';
import { runSiteInvestigation } from '../../domain/spatial/terrain_engine.js';
import { getSiteInsights, PERSONA_CONFIG } from '../../domain/spatial/siteInsightMapper.js';
import { synthesizeSiteAnalysis } from '../../domain/spatial/synthesis_engine.js';

export const SiteInvestigationPanel = () => {
  const activePersona = store.getState().system.activePersona || 'developer';
  const [site, setSite] = useState(store.getActiveScenario()?.site || {});
  const [terrainData, setTerrainData] = useState(store.getState().site?.investigation?.terrainData || null);
  const [lookupAddr, setLookupAddr] = useState("");
  const [suggestions, setSuggestions] = useState([]);
  const [isSuggesting, setIsSuggesting] = useState(false);
  const [analysisStatus, setAnalysisStatus] = useState("idle");
  const [viewMode, setViewMode] = useState('persona'); // 'persona' | 'synthesis'
  const [docParsing, setDocParsing] = useState(false);
  const [docReview, setDocReview] = useState(null);
  const [extractionProgress, setExtractionProgress] = useState(false);

  useEffect(() => {
    const unsubscribe = store.subscribe((state) => {
      setSite(store.getActiveScenario()?.site || {});
      setTerrainData(store.getState().site?.investigation?.terrainData || null);
    });
    return () => unsubscribe();
  }, []);

  const debounceTimer = useRef(null);

  const formatAUAddress = (data) => {
    const addr = data.address;
    if (!addr) return data.display_name;
    const houseNum = addr.house_number || addr.housenumber || "";
    const road = addr.road || "";
    const suburb = addr.suburb || addr.town || addr.city || "";
    const state = addr.state === "Victoria" ? "VIC" : (addr.state === "New South Wales" ? "NSW" : (addr.state === "Queensland" ? "QLD" : (addr.state || "")));
    const postcode = addr.postcode || "";
    const country = addr.country || "Australia";
    return `${houseNum} ${road}, ${suburb} ${state} ${postcode}, ${country}`.trim();
  };

  const fetchSuggestions = async (query) => {
    if (!query.trim() || query.length < 3) {
      setSuggestions([]);
      return;
    }
    setIsSuggesting(true);
    const cleanedQuery = query.replace(/[\u4e00-\u9fa5]+/g, '').replace(/\s\s+/g, ' ').trim();
    try {
      const res = await fetch(`https://nominatim.openstreetmap.org/search?q=${encodeURIComponent(cleanedQuery)}&format=json&addressdetails=1&limit=5&countrycodes=au&accept-language=en`);
      const data = await res.json();
      if (data && data.length > 0) {
        const formatted = data.map(item => ({ 
          id: item.place_id, 
          name: formatAUAddress(item),
          lat: item.lat,
          lon: item.lon
        }));
        setSuggestions(formatted);
      } else {
        setSuggestions([]);
      }
    } catch (e) {
      console.error("Autocomplete failed", e);
      setSuggestions([]);
    } finally {
      setIsSuggesting(false);
    }
  };

  const handleInputChange = (val) => {
    setLookupAddr(val);
    if (debounceTimer.current) clearTimeout(debounceTimer.current);
    debounceTimer.current = setTimeout(() => {
      fetchSuggestions(val);
    }, 300);
  };

  const handleClearSite = () => {
    setLookupAddr("");
    setTerrainData(null);
    setAnalysisStatus("idle");
    setSuggestions([]);
    store.dispatch('site.address', "");
    store.dispatch('site.lat', null); 
    store.dispatch('site.lon', null); 
    store.dispatch('site.investigation.terrainData', null);
    store.dispatch('site.investigation.synthesis', null);
  };

  const selectAddress = async (item) => {
    setTerrainData(null);
    setAnalysisStatus("loading");
    
    store.dispatch('site.address', item.name);
    store.dispatch('site.lat', item.lat); 
    store.dispatch('site.lon', item.lon); 
    
    store.dispatch('site.investigation.synthesis', null);
    store.dispatch('site.investigation.facts', []);
    
    setLookupAddr(item.name);
    setSuggestions([]);
    
    try {
      const terrainResults = await runSiteInvestigation(item.lat, item.lon);
      
      store.dispatch('site.area', terrainResults.siteArea || 650);
      store.dispatch('site.frontage', terrainResults.frontage || 15);
      store.dispatch('site.depth', terrainResults.depth || 43);
      store.dispatch('site.investigation.terrainData', terrainResults);
      
      setTerrainData(terrainResults);
      setAnalysisStatus("done");
    } catch (e) {
      setAnalysisStatus("error");
      console.error("Site acquisition chain failed", e);
    }
  };

  const handleRunAnalysis = async () => {
    if (!site.address) {
      alert("Please enter and select a valid address first.");
      return;
    }
    setAnalysisStatus("loading");
    store.dispatch('site.investigation.terrainData', null);
    setTerrainData(null);
    
    try {
      const lat = site.lat || -37.28; 
      const lon = site.lon || 145.13;
      const results = await runSiteInvestigation(lat, lon);
      
      store.dispatch('site.area', results.siteArea || 650);
      store.dispatch('site.frontage', results.frontage || 15);
      store.dispatch('site.depth', results.depth || 43);
      store.dispatch('site.investigation.terrainData', results);
      setTerrainData(results);
      setAnalysisStatus("done");
    } catch (e) {
      setAnalysisStatus("error");
      console.error("Analysis failed", e);
    }
  };

  const handleDocUpload = async (e, type) => {
    const file = e.target.files[0];
    if (!file) return;
    setDocParsing(true);
    setDocReview(prev => ({ ...prev, [type]: 'parsing' }));
    try {
      const text = await extractFileText(file);
      if (type === 's32') {
        const aiResult = await parseDocumentWithAI(text);
        setDocReview(prev => ({ ...prev, s32: aiResult }));
      } else if (type === 'vp') {
        setDocReview(prev => ({ ...prev, vp: text }));
      } else if (type === 'fsp') {
        setDocReview(prev => ({ ...prev, fsp: text }));
      }
    } catch (err) {
      console.error(`Extraction failed for ${type}`, err);
      setDocReview(prev => ({ ...prev, [type]: null }));
    } finally {
      setDocParsing(false);
    }
  };

  const applyExtraction = async () => {
    if (!docReview) return;
    setExtractionProgress(true);
    try {
      const { updatedSiteState, synthesis } = await extractAllFields(
        docReview.vp || "", 
        docReview.s32?.text || "", 
        docReview.fsp || ""
      );
      
      Object.entries(updatedSiteState).forEach(([key, value]) => {
        store.dispatch(key, value);
      });
      
      store.dispatch('site.investigation.synthesis', synthesis);
      store.dispatch('site.investigation.facts', synthesis.facts || []);
      
      setDocReview(null);
      alert("Site constraints successfully applied to financial model.");
    } catch (e) {
      console.error("Extraction application failed", e);
      alert("Failed to apply extraction. Please check console.");
    } finally {
      setExtractionProgress(false);
    }
  };

  const renderSovereignSynthesis = () => {
    if (!terrainData) return null;
    
    const activeScenario = store.getActiveScenario();
    const overrides = activeScenario?.trustOverrides || {};
    const { matrix, alignment, decisionWaterfall, summary } = synthesizeSiteAnalysis(terrainData, {}, overrides);
    const personas = ['developer', 'architect', 'builder'];

    const trustStyles = {
      CONFLICT: { color: '#c53030', bg: '#fff5f5', label: 'CONFLICT', icon: '❌' },
      VERIFIED: { color: '#2f855a', bg: '#f0fff4', label: 'VERIFIED', icon: '✅' },
      EXTRACTED: { color: '#2b6cb0', bg: '#ebf8ff', label: 'EXTRACTED', icon: '📄' },
      ESTIMATED: { color: '#718096', bg: '#f7fafc', label: 'ESTIMATED', icon: '⚙️' },
    };

    const handleVerify = (key) => {
      const currentOverrides = { ...overrides };
      currentOverrides[key] = 'VERIFIED';
      store.dispatch('site.investigation.trustOverrides', currentOverrides);
    };

    return (
      <div style={{ display: 'flex', flexDirection: 'column', gap: T.sp.md }}>
        
        {/* 1. Sovereign Data Alignment Bar (Interactive) */}
        <div style={{ 
          display: 'flex', 
          gap: T.sp.sm, 
          padding: T.sp.sm, 
          backgroundColor: '#f8fafc', 
          borderRadius: T.r.sm, 
          border: `1px solid ${C.border}`,
          overflowX: 'auto'
        }}>
          {Object.entries(alignment).map(([key, data]) => {
            const style = trustStyles[data.status] || trustStyles.ESTIMATED;
            const isVerified = data.status === 'VERIFIED';
            return (
              <div key={key} style={{ 
                display: 'flex', 
                alignItems: 'center', 
                gap: 6, 
                padding: '4px 8px', 
                borderRadius: T.r.xs, 
                backgroundColor: style.bg, 
                border: `1px solid ${style.color}`,
                fontSize: T.fs.xs,
                fontWeight: 700,
                color: style.color,
                whiteSpace: 'nowrap'
              }}>
                <span>{style.icon}</span>
                <span>{data.label}: {style.label}</span>
                {!isVerified && (
                  <button 
                    onClick={() => handleVerify(key)}
                    style={{ 
                      marginLeft: 4, 
                      border: 'none', 
                      backgroundColor: style.color, 
                      color: '#fff', 
                      borderRadius: '50%', 
                      width: 14, 
                      height: 14, 
                      cursor: 'pointer', 
                      fontSize: '8px', 
                      display: 'flex', 
                      alignItems: 'center', 
                      justifyContent: 'center',
                      fontWeight: 'bold'
                    }}
                    title="Manually Verify"
                  >
                    ✓
                  </button>
                )}
              </div>
            );
          })}
        </div>

        {/* 2. Decision Waterfall -> Sovereign Audit Cards */}
        <div style={{ display: 'flex', flexDirection: 'column', gap: T.sp.sm }}>
          {decisionWaterfall.map((step, idx) => {
            const isAlert = step.type === 'ALERT';
            const isAdvice = step.type === 'ADVICE';
            const isSuccess = step.type === 'SUCCESS';
            
            // Attempt to find a matching alignment metric to show a confidence bar
            const matchedMetric = Object.entries(alignment).find(([k, v]) => 
              step.conclusion.toLowerCase().includes(v.label.toLowerCase())
            );
            const confidenceScore = matchedMetric ? matchedMetric[1].score : (isSuccess ? 100 : 50);
            
            return (
              <div key={idx} style={{ 
                padding: T.sp.md, 
                backgroundColor: '#fff', 
                borderRadius: T.r.md, 
                border: `1px solid ${C.border}`,
                borderLeft: `4px solid ${isAlert ? '#c53030' : (isAdvice ? '#2b6cb0' : '#2f855a')}`,
                boxShadow: isAlert ? '0 2px 4px rgba(197, 48, 48, 0.1)' : 'none',
                transition: 'transform 0.2s ease'
              }}>
                <div style={{ 
                  display: 'flex', 
                  justifyContent: 'space-between',
                  alignItems: 'center',
                  marginBottom: 8,
                }}>
                  <div style={{ 
                    display: 'flex', 
                    alignItems: 'center', 
                    gap: 8, 
                    fontWeight: 800, 
                    fontSize: T.fs.sm, 
                    color: isAlert ? '#c53030' : (isAdvice ? '#2b6cb0' : '#2f855a') 
                  }}>
                    <span>{isAlert ? '⚠️' : (isAdvice ? 'ℹ️' : '✅')}</span>
                    <span>{step.conclusion}</span>
                  </div>
                  <div style={{ fontSize: '10px', fontWeight: 800, color: C.textSecondary }}>
                    CONFIDENCE: {confidenceScore}%
                  </div>
                </div>

                {/* Confidence Visual Bar */}
                <div style={{ 
                  width: '100%', 
                  height: 4, 
                  backgroundColor: '#edf2f7', 
                  borderRadius: 2, 
                  marginBottom: 12,
                  overflow: 'hidden'
                }}>
                  <div style={{ 
                    width: `${confidenceScore}%`, 
                    height: '100%', 
                    backgroundColor: confidenceScore > 80 ? '#2f855a' : (confidenceScore > 50 ? '#fdcb6e' : '#c53030'),
                    transition: 'width 0.5s ease'
                  }} />
                </div>

                <div style={{ display: 'flex', gap: T.sp.md, fontSize: T.fs.xs, color: C.text, lineHeight: 1.5 }}>
                  <div style={{ flex: 1, paddingRight: T.sp.sm, borderRight: `1px solid ${C.border}` }}>
                    <div style={{ fontWeight: 700, color: C.textSecondary, marginBottom: 4 }}>Evidence Chain</div>
                    {step.evidence}
                  </div>
                  <div style={{ flex: 1, paddingLeft: T.sp.sm }}>
                    <div style={{ fontWeight: 700, color: C.textSecondary, marginBottom: 4 }}>Decision Impact</div>
                    {step.impact}
                  </div>
                </div>
              </div>
            );
          })}
        </div>

        {/* 3. Executive Summary */}
        <div style={{ 
          marginTop: T.sp.md, 
          padding: T.sp.md, 
          backgroundColor: '#fff', 
          border: `1px solid ${C.border}`, 
          borderRadius: T.r.md, 
          borderLeft: `4px solid ${C.brand}`, 
          display: 'flex', 
          gap: T.sp.lg, 
          alignItems: 'flex-start' 
        }}>
          <div style={{ flex: 1 }}>
            <div style={{ fontWeight: 800, fontSize: T.fs.sm, color: C.brand, marginBottom: 8 }}>Sovereign Intelligence Summary</div>
            <div style={{ color: C.text, lineHeight: 1.6, fontSize: T.fs.xs }}>
              {typeof summary === 'string' ? summary : summary?.text}
            </div>
          </div>
        </div>
      </div>
    );
  };

  return (
    <UIPanel title="Site Investigation & Sovereign Analysis">
      <div style={{ display: 'flex', flexDirection: 'column', gap: T.sp.lg }}>
        
        {/* STEP 1: SITE DISCOVERY */}
        <div style={{ 
          display: 'flex', 
          flexDirection: 'column', 
          gap: T.sp.sm, 
          padding: T.sp.md, 
          backgroundColor: '#fff', 
          borderRadius: T.r.md, 
          border: `1px solid ${C.border}` 
        }}>
          <div style={{ 
            display: 'flex', 
            alignItems: 'center', 
            gap: 8, 
            marginBottom: 4 
          }}>
            <div style={{ 
              backgroundColor: C.brand, 
              color: '#fff', 
              width: 20, 
              height: 20, 
              borderRadius: '50%', 
              display: 'flex', 
              alignItems: 'center', 
              justifyContent: 'center', 
              fontSize: '10px', 
              fontWeight: 800 
            }}>1</div>
            <div style={{ fontWeight: 800, fontSize: T.fs.sm, color: C.textSecondary, textTransform: 'uppercase', letterSpacing: 1 }}>Step 1: Site Discovery</div>
          </div>

          <div style={{ display: 'flex', gap: T.sp.md, alignItems: 'flex-end' }}>
            <div style={{ flex: 1, position: 'relative' }}>
              <UIInput 
                label="Property Address" 
                value={lookupAddr} 
                onChange={handleInputChange} 
                placeholder="Search address (e.g. 65 Lowan Ave, Templestowe Lower)"
              />
              {suggestions.length > 0 && (
                <div style={{ position: 'absolute', top: '100%', left: 0, right: 0, backgroundColor: '#fff', border: `1px solid ${C.border}`, borderRadius: T.r.sm, zIndex: 100, boxShadow: '0 4px 12px rgba(0,0,0,0.1)', marginTop: 4 }}>
                  {suggestions.map(item => (
                    <div 
                      key={item.id} 
                      onClick={() => selectAddress(item)} 
                      style={{ padding: '10px 12px', cursor: 'pointer', borderBottom: `1px solid ${C.border}`, fontSize: T.fs.xs, transition: 'background 0.2s' }}
                      onMouseEnter={(e) => e.target.style.backgroundColor = '#f8fafc'}
                      onMouseLeave={(e) => e.target.style.backgroundColor = '#fff'}
                    >
                      {item.name}
                    </div>
                  ))}
                </div>
              )}
            </div>
            <div style={{ display: 'flex', gap: T.sp.sm }}>
              <UIButton 
                label="Clear" 
                onClick={handleClearSite} 
                variant="ghost"
                style={{ color: C.textSecondary }}
              />
              <UIButton 
                label="Run Deep Analysis" 
                onClick={handleRunAnalysis} 
                disabled={analysisStatus === 'loading'} 
                variant="primary"
              />
            </div>
          </div>
        </div>

        {/* STEP 2: INTELLIGENCE SWEEP */}
        <div style={{ 
          display: 'flex', 
          flexDirection: 'column', 
          gap: T.sp.sm, 
          padding: T.sp.md, 
          backgroundColor: '#fff', 
          borderRadius: T.r.md, 
          border: `1px solid ${C.border}` 
        }}>
          <div style={{ 
            display: 'flex', 
            alignItems: 'center', 
            gap: 8, 
            marginBottom: 4 
          }}>
            <div style={{ 
              backgroundColor: C.brand, 
              color: '#fff', 
              width: 20, 
              height: 20, 
              borderRadius: '50%', 
              display: 'flex', 
              alignItems: 'center', 
              justifyContent: 'center', 
              fontSize: '10px', 
              fontWeight: 800 
            }}>2</div>
            <div style={{ fontWeight: 800, fontSize: T.fs.sm, color: C.textSecondary, textTransform: 'uppercase', letterSpacing: 1 }}>Step 2: Intelligence Sweep</div>
          </div>

          <div style={{ 
            padding: T.sp.md, 
            backgroundColor: '#f8fafc', 
            borderRadius: T.r.sm, 
            border: `1px dashed ${C.border}`,
            display: 'flex',
            flexDirection: 'column',
            gap: T.sp.md
          }}>
            <div style={{ fontWeight: 700, fontSize: T.fs.xs, color: C.textSecondary }}>Document Intelligence Upload</div>
            <div style={{ display: 'flex', gap: T.sp.md, flexWrap: 'wrap' }}>
              {[
                { id: 'vp', label: 'VicPlan', icon: '🗺️' },
                { id: 's32', label: 'Section 32', icon: '📄' },
                { id: 'fsp', label: 'Feasibility Report', icon: '📊' }
              ].map(doc => (
                <div key={doc.id} style={{ display: 'flex', flexDirection: 'column', gap: 4 }}>
                  <label style={{ fontSize: T.fs.xs, fontWeight: 600, color: C.text }}>{doc.icon} {doc.label}</label>
                  <input 
                    type="file" 
                    onChange={(e) => handleDocUpload(e, doc.id)} 
                    style={{ fontSize: T.fs.xs }} 
                  />
                  {docReview?.[doc.id] === 'parsing' && <div style={{ fontSize: '10px', color: C.brand }}>Parsing...</div>}
                </div>
              ))}
              <UIButton 
                label="Apply to Model" 
                onClick={applyExtraction} 
                disabled={!docReview || extractionProgress}
                variant="secondary"
                style={{ alignSelf: 'flex-end' }}
              />
            </div>
          </div>
        </div>

        {/* RESULTS SECTION */}
        {terrainData && (
          <div style={{ display: 'flex', flexDirection: 'column', gap: T.sp.md }}>
            <div style={{ display: 'flex', gap: T.sp.sm }}>
              <UIButton 
                label="Persona View" 
                variant={viewMode === 'persona' ? 'primary' : 'ghost'} 
                onClick={() => setViewMode('persona')} 
              />
              <UIButton 
                label="Sovereign Synthesis" 
                variant={viewMode === 'synthesis' ? 'primary' : 'ghost'} 
                onClick={() => setViewMode('synthesis')} 
              />
            </div>

            {viewMode === 'persona' ? (
              <div style={{ display: 'grid', gridTemplateColumns: 'repeat(auto-fit, minmax(300px, 1fr))', gap: T.sp.md }}>
                {Object.entries(PERSONA_CONFIG).map(([pKey, config]) => {
                  const insights = getSiteInsights(terrainData, pKey);
                  return (
                    <div key={pKey} style={{ padding: T.sp.md, backgroundColor: '#fff', border: `1px solid ${C.border}`, borderRadius: T.r.md, borderTop: `4px solid ${config.color}` }}>
                      <div style={{ fontWeight: 800, color: config.color, marginBottom: T.sp.sm, display: 'flex', alignItems: 'center', gap: 8 }}>
                        {config.icon} {config.label}
                      </div>
                      <div style={{ display: 'flex', flexDirection: 'column', gap: 8 }}>
                        {insights.metrics?.map((ins, i) => (
                          <div key={i} style={{ fontSize: T.fs.xs, color: C.text, lineHeight: 1.4 }}>
                            <span style={{ fontWeight: 700, color: ins.impact === 'Critical' ? '#c53030' : (ins.impact === 'Positive' ? '#2f855a' : C.text) }}>
                              {ins.impact === 'Critical' ? '⚠️' : (ins.impact === 'Positive' ? '✅' : 'ℹ️')}
                            </span>
                            {ins.text}
                          </div>
                        ))}
                      </div>
                    </div>
                  );
                })}
              </div>
            ) : (
              renderSovereignSynthesis()
            )}
          </div>
        )}

        {analysisStatus === 'loading' && (
          <div style={{ textAlign: 'center', padding: T.sp.lg, color: C.textSecondary, fontSize: T.fs.sm }}>
            Analyzing site geospatial data and risk vectors...
          </div>
        )}
      </div>
    </UIPanel>
  );
};
