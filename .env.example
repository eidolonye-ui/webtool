# WebTool SaaS Environment Configuration Template
# Create a .env file in the root and fill in these values.
# Vite requires variables to be prefixed with VITE_ to be exposed to the client.

# AI Configuration (Ollama)
VITE_AI_ENDPOINT=http://localhost:11434
VITE_AI_MODEL=llama3.2

# Market Data APIs
VITE_RBA_API_BASE=https://api.rba.gov.au
VITE_ABS_API_BASE=https://api.data.abs.gov.au

# Spatial Data APIs
VITE_OPENTOPODATA_ENDPOINT=https://api.opentopodata.org/v1/srtm30m
VITE_OVERPASS_ENDPOINT=https://overpass-api.de/api/interpreter

# Google Tasks API (if used)
VITE_GOOGLE_TASKS_API=https://tasks.googleapis.com/tasks/v1
